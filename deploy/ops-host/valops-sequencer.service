# Ops host process class: sequencer (HLD §4.3). One uid per class; credentials are disjoint.
[Unit]
Description=valops sequencer
After=network-online.target valops-sequencer.service
PartOf=valops.target

[Service]
Type=simple
User=valops-sequencer
Group=valops-sequencer
SupplementaryGroups=valops-sock
ExecStart=/opt/valops/venv/bin/valops serve --config /etc/valops/ops.yaml sequencer
Restart=on-failure
RestartSec=3
RuntimeDirectory=valops
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0750
StateDirectory=valops
UMask=0007
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/valops /run/valops
CapabilityBoundingSet=
NoNewPrivileges=yes

[Install]
WantedBy=valops.target
